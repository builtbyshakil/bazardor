# Copy this file to .env.local and fill in your own values

# Any long random string (run: npx @better-auth/cli secret)
BETTER_AUTH_SECRET=

# Local: http://localhost:3000  |  Production: your Vercel URL
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# MongoDB Atlas connection string (free tier is enough)
MONGODB_URI=

# Google login (Google Cloud Console -> OAuth client)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub login (GitHub -> Settings -> Developer settings -> OAuth Apps)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
